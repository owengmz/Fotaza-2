extends ../layout
block title
  | #{publicacion.titulo} | Fotaza

block content
  article.detalle
    .detalle__header
      h1.detalle__titulo= publicacion.titulo
      p.detalle__autor
        | Por&nbsp;
        a(href=`/perfil/${publicacion.autor.nombreUsuario}`)= publicacion.autor.nombreUsuario
      if publicacion.descripcion
        p.detalle__descripcion= publicacion.descripcion
      if publicacion.etiquetas && publicacion.etiquetas.length
        .detalle__etiquetas
          each etiqueta in publicacion.etiquetas
            span.etiqueta= etiqueta.nombre

    .detalle__imagenes
      each imagen in imagenes
        .detalle__imagen-bloque
          img.detalle__img(src=imagen.url alt=publicacion.titulo)
          .detalle__valoracion
            if imagen.cantidad > 0
              span Promedio: #{imagen.promedio} (#{imagen.cantidad} valoraciones)
            else
              span Sin valoraciones todavia
          if usuarioId
            form.valoracion__form(action=`/publicaciones/${publicacion.id}/imagenes/${imagen.id}/valorar` method="POST")
              select.form__input(name="valor" required)
                option(value="") Valorar
                option(value="1") 1
                option(value="2") 2
                option(value="3") 3
                option(value="4") 4
                option(value="5") 5
              button.btn.btn--primario(type="submit") Enviar
            form(action=`/publicaciones/${publicacion.id}/imagenes/${imagen.id}/me-interesa` method="POST")
              button.btn.btn--secundario(type="submit") Me interesa
            form.denuncia__form(action=`/publicaciones/${publicacion.id}/imagenes/${imagen.id}/denunciar` method="POST")
              select.form__input(name="motivo" required)
                option(value="") Denunciar imagen...
                option(value="contenido_inapropiado") Contenido inapropiado
                option(value="copyright") Copyright
                option(value="spam") Spam
                option(value="otro") Otro
              textarea.form__input(name="descripcion" rows="2" placeholder="Describe el problema" required)
              button.btn.btn--peligro(type="submit") Denunciar

    if usuarioId && colecciones && colecciones.length
      section.detalle__colecciones
        form(method="POST" onsubmit=`event.preventDefault(); this.action='/colecciones/'+this.querySelector('[name=coleccionId]').value+'/publicaciones/${publicacion.id}'; this.submit()`)
          select.form__input(name="coleccionId" required)
            option(value="") Guardar en coleccion...
            each coleccion in colecciones
              option(value=coleccion.id)= coleccion.nombre
          button.btn.btn--secundario(type="submit") Guardar

    section.detalle__comentarios
      h2.comentarios__titulo Comentarios
      if publicacion.comentariosAbiertos && usuarioId
        form.comentario__form(action=`/publicaciones/${publicacion.id}/comentarios` method="POST")
          textarea.form__input(
            name="contenido"
            rows="3"
            placeholder="Escribi tu comentario..."
            required
          )
          button.btn.btn--primario(type="submit") Comentar

      if publicacion.comentarios && publicacion.comentarios.length
        .comentarios__lista
          each comentario in publicacion.comentarios
            article.comentario
              p.comentario__autor= comentario.autor.nombreUsuario
              p.comentario__contenido= comentario.contenido
              p.comentario__fecha= new Date(comentario.createdAt).toLocaleDateString('es-AR')
              if usuarioId
                form.denuncia__form(action=`/publicaciones/${publicacion.id}/comentarios/${comentario.id}/denunciar` method="POST")
                  select.form__input(name="motivo" required)
                    option(value="") Denunciar comentario...
                    option(value="contenido_inapropiado") Contenido inapropiado
                    option(value="copyright") Copyright
                    option(value="spam") Spam
                    option(value="otro") Otro
                  textarea.form__input(name="descripcion" rows="2" placeholder="Describe el problema" required)
                  button.btn.btn--peligro(type="submit") Denunciar
              if esAutor
                form(action=`/publicaciones/${publicacion.id}/comentarios/${comentario.id}/borrar` method="POST")
                  button.btn.btn--peligro(type="submit") Borrar comentario
      else
        p.comentarios__vacio No hay comentarios todavia.